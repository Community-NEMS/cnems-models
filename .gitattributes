# Normalize line endings so Git and pre-commit's `mixed-line-ending --fix=lf` hook
# agree.  Without this, a Windows checkout with core.autocrlf=true gets CRLF in the
# working tree, which the hook then rewrites back to LF on every commit.  `text=auto`
# leaves Git's binary detection in charge, so images/fonts/pickles are untouched.
* text=auto eol=lf

# TODO:  come back to this.  It is inconsistent with several .bat files already in the repo
# Batch files are the exception: cmd.exe has known edge cases around labels and `goto`
# in LF-only scripts, so these keep CRLF in the working tree regardless of platform.

# *.bat text eol=crlf

# Tell GitHub's linguist (and thus PR diffs) that this is a generated file, so it's
# collapsed by default in PRs instead of dominating the diff every time a dependency
# changes. merge=ours keeps our side on conflict instead of trying to line-merge a
# huge generated lockfile -- pixi.lock gets regenerated by `pixi install`/`pixi update`
# anyway, so a hand-merged version would just be replaced.
pixi.lock merge=ours linguist-generated=true

# Don't let notebook JSON dominate GitHub's per-repo language statistics.
*.ipynb linguist-detectable=false

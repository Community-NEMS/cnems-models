# agents & such
# Local settings and hooks stay untracked (settings.local.json holds a personal
# permission allowlist; settings.json hardcodes an absolute hook path). Shared
# skills are committed so docs conventions travel with the repo.
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/zensical-docs/

# coverage
coverage.xml
.coverage
# per-worker data files written by pytest-cov under xdist, normally consumed by
# `coverage combine`; they survive an interrupted run and `.coverage` does not match them
.coverage.*
